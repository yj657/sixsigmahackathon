# Copy this file to app/.env (same folder as deployme.sh), then fill in the
# two values from the event. Never commit app/.env — it is gitignored.
#
#   cp .env.example .env
#
# Use the SAME values you put in GitHub Actions secrets (CONNECT_SERVER,
# CONNECT_API_KEY). Do not put quotes unless the value itself needs them.

CONNECT_SERVER=https://your-connect-server.example.com
CONNECT_API_KEY=paste-your-publisher-key-here
